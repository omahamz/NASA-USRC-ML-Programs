<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SwGen — drives SolidWorks through its COM API to batch-generate STEP files
    from parametric SLDPRT templates (global-variable equations).

    Targets .NET Framework 4.8: SolidWorks' interop assemblies are built for it,
    and Marshal.GetActiveObject (attach to a running SolidWorks) only exists there.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>SwGen</RootNamespace>
    <AssemblyName>SwGen</AssemblyName>

    <!-- Override on the command line if SolidWorks is installed elsewhere:
         dotnet build -p:SolidWorksApiDir="D:\SOLIDWORKS\api\redist" -->
    <SolidWorksApiDir Condition="'$(SolidWorksApiDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
